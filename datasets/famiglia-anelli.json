      "regionSource": null,
      "geographicReferences": [],
      "sections": [
        {
          "title": "Ingredienti",
          "type": "unordered",
          "items": [
            "300 gr. farina 0",
            "200 gr. farina manitoba",
            "400 gr. acqua temperatura ambiente",
            "3 gr. lievito di birra o 1.5 gr. di birra secco",
            "1 cucchiaio olio",
            "11 gr. sale",
            "1/2 cucchiaino zucchero"
